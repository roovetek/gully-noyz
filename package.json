    "test:schema:local": "node scripts/schema-sanity-check.mjs --target=local",
    "test:schema:remote": "node scripts/schema-sanity-check.mjs --target=remote",
    "test:schema:both": "node scripts/schema-sanity-check.mjs --target=both",
    "qa:harness": "node scripts/qa-harness.mjs",
    "delete-match": "node scripts/delete-match.mjs",
    "ai:service": "uvicorn app.main:app --app-dir services/local-ai --host 127.0.0.1 --port 8000 --reload"
